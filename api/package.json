{
  "name": "api-boilerplate",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "node ./node_modules/pm2/bin/pm2-runtime start ecosystem.develop.config.js",
    "lint": "eslint \"app/**/*.{js,ts}\" --fix",
    "prettier": "prettier --write --print-width 120  --trailing-comma all \"**/*.+(ts|js)\"",
    "commit-hook": "npm run license-checker && npm run jsdoc && npm run prettier && npm run lint && git add . && npm run test",
    "start": "node ./node_modules/pm2/bin/pm2-runtime start ecosystem.config.js",
    "test": "NODE_ENV=test jest --runInBand --forceExit --coverage",
    "knex": "knex --knexfile app/knexConfig.ts",
    "jsdoc": "typedoc",
    "license-checker": "license-checker-rseidelsohn --production --json --out licenses.json && chmod 644 licenses.json && node licence_review.js"
  },
  "pre-commit": [
    "commit-hook"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@bitbucket.org/inigollc/ecms_api.git"
  },
  "author": "",
  "license": "ISC",
  "homepage": "https://bitbucket.org/inigollc/ecms_api#readme",
  "engines": {
    "node": "20.12.2"
  },
  "overrides": {
    "glob": "npm:fast-glob@3.3.2",
    "braces": "3.0.3",
    "ws": "8.18.0"
  },
